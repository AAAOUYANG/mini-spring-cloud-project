## 实体 DTO 模板：字段与实体一一对应，排除逻辑删除字段；
## password 标记为 WRITE_ONLY（可接收、不回显），LocalDateTime 统一序列化格式。
package ${package.Parent}.domain.dto;

import com.fasterxml.jackson.annotation.JsonFormat;
import com.fasterxml.jackson.annotation.JsonProperty;
import lombok.Data;

import java.io.Serializable;
#set($hasLocalDateTime = false)
#set($hasLocalDate = false)
#set($hasLocalTime = false)
#set($hasBigDecimal = false)
#foreach($field in ${table.fields})
#if(${field.propertyType} == "LocalDateTime")#set($hasLocalDateTime = true)#end
#if(${field.propertyType} == "LocalDate")#set($hasLocalDate = true)#end
#if(${field.propertyType} == "LocalTime")#set($hasLocalTime = true)#end
#if(${field.propertyType} == "BigDecimal")#set($hasBigDecimal = true)#end
#end
#if($hasLocalDateTime)
import java.time.LocalDateTime;
#end
#if($hasLocalDate)
import java.time.LocalDate;
#end
#if($hasLocalTime)
import java.time.LocalTime;
#end
#if($hasBigDecimal)
import java.math.BigDecimal;
#end

/**
 * <p>
 * $!{table.comment} DTO
 * </p>
 *
 * @author ${author}
 * @since ${date}
 */
@Data
public class ${entity}DTO implements Serializable {

    private static final long serialVersionUID = 1L;
#foreach($field in ${table.fields})
#if(${field.propertyName} != "deleted")

    /** $!{field.comment} */
#if(${field.propertyName} == "password")
    @JsonProperty(access = JsonProperty.Access.WRITE_ONLY)
#end
#if(${field.propertyType} == "LocalDateTime")
    @JsonFormat(pattern = "yyyy-MM-dd HH:mm:ss")
#end
    private ${field.propertyType} ${field.propertyName};
#end
#end
}