# ============================================================================
# prod 环境变量（docker/app 的容器化模式）
#
# 用法（从仓库根目录执行；image 的 :prod 由流水线「生产闸门与晋级」阶段打出来）：
#   APP_ENV=prod IMAGE_TAG=prod docker compose -f docker/app/docker-compose.yml up -d
#
# 注意：本文件的镜像 tag 是移动指针，只适合本机模拟；真实生产应当部署**不可变 tag**
#（提交短 SHA / 镜像 digest），并且用密钥管理注入密码，而不是放在仓库里。
# ============================================================================

NACOS_NAMESPACE=prod

IMAGE_TAG=prod

# 刻意**不在环境变量里设数据源**：库地址由各自 Nacos 命名空间的 mini-env.yaml 决定（dev/prod 一致）。
# 环境变量是最高优先级的「逃生口」，临时覆盖请用标准变量 SPRING_DATASOURCE_URL——默认不用它，
# 才能保证「配置中心里看到的就是实际生效的」。
#
# 同理，DB_PASSWORD 目前仍由 compose 的 MYSQL_ROOT_PASSWORD 兜底（本地测试环境），
# 真实生产应由 Jenkins 凭据 / 密钥管理注入，绝不进仓库。