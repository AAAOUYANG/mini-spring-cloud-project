# 复制为 .env 后按需修改：cp .env.example .env
# （.env 已被 .gitignore 忽略；compose 中每个变量都有默认值，但 WORKSPACE_DIR 必须设置）

# Jenkins 挂载代码用的仓库绝对路径，必须与宿主路径完全一致
# 获取方式：在仓库根目录执行 pwd
WORKSPACE_DIR=/absolute/path/to/mini-spring-cloud-project

# 前端仓库（mini-vue3-project）的绝对路径。Jenkins 也把它挂进来，让
# mini-vue3-frontend-dev / -prod 两个任务能读到前端仓库里的 Jenkinsfile 并构建前端镜像。
# 同样必须与宿主路径完全一致（docker-outside-of-docker 的前提）。
# 只做后端时可以填一个不存在的路径占位——本变量为必填，compose 会校验非空。
FRONTEND_DIR=/absolute/path/to/mini-vue3-project

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mini_spring_boot
# 宿主 3306 若已被占用，改这里（容器内始终是 3306）
MYSQL_HOST_PORT=13306
NACOS_DB_NAME=nacos_config

# Jenkins
JENKINS_HOST_PORT=8080
JENKINS_AGENT_PORT=50000

# Portainer（容器可视化）；容器内固定 9000，宿主 9000 已被网关占用
PORTAINER_HOST_PORT=9001

TZ=Asia/Shanghai